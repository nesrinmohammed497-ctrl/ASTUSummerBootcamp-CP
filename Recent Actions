t = int(input())
for _ in range(t):
    n, m = map(int, input().split())
    p = list(map(int, input().split()))
    ans = [-1] * (n + 1)
    seen = set()
    removed = 0
    for time, post in enumerate(p, 1):
        if post not in seen:
            seen.add(post)
            removed += 1
            if removed <= n:
                ans[n - removed + 1] = time
    print(*ans[1:])
